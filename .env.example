# Copy this file to .env for local Docker runs.
# Keep the real bearer key out of git; obtain it through the approved
# private secret channel for the declarai-auto-ml engine tenant.

LLM_ENGINE_BASE_URL=http://host.docker.internal:8080/v1
LLM_ENGINE_API_KEY=

# Exact frontend origins allowed to use Django sessions and CSRF.
DECLARAI_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:4301,http://127.0.0.1:4301

# The bundled live-reload Docker stack is development only (SQLite by default).
# Private mode needs an independently qualified WSGI/ASGI/TLS installation.
DECLARAI_RUNTIME_PROFILE=development
# Private configuration reference: docs/private-runtime-configuration.md.
# Supply secret values OR *_FILE sources; never configure both.
# DJANGO_SECRET_KEY_FILE=/run/secrets/django-key
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.example.internal
# DECLARAI_ALLOWED_ORIGINS=https://console.example.internal
# DECLARAI_MEDIA_ROOT=/var/lib/declarai/artifacts
# DECLARAI_DB_ENGINE=postgresql
# DECLARAI_DB_NAME=declarai
# DECLARAI_DB_USER=declarai_app
# DECLARAI_DB_PASSWORD_FILE=/run/secrets/postgres-password
# DECLARAI_DB_HOST=postgres.example.internal
# DECLARAI_DB_PORT=5432
# DECLARAI_DB_SSLMODE=verify-full
# DECLARAI_DB_SSLROOTCERT=/run/certificates/postgres-ca.pem
# DJANGO_TRUST_PROXY_TLS=false
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
